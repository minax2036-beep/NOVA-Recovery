cc_library_static {
    name: "libnova_recovery_display",
    recovery_available: true,
    srcs: [
        "src/logger.cpp",
        "src/renderer.cpp",
        "src/framebuffer.cpp",
        "src/recovery_display_minui.cpp",
    ],
    export_include_dirs: ["include"],
    shared_libs: ["libminui"],
    cflags: ["-Wall", "-Wextra", "-Wpedantic"],
    cppflags: ["-std=c++17"],
}
